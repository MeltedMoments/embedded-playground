{
  "version": 1,
  "author": "Jennie",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-s3-devkitc-1",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {
        "serialInterface": "USB_SERIAL_JTAG",
        "flashSize": "16",
        "psramSize": "8",
        "psramType": "octal"
      }    
    },
    {
      "type": "wokwi-led-strip",
      "id": "strip",
      "top": 0,
      "left": 250,
      "attrs": {
        "pixels": "8"
      }    
    }
  ],
  "connections": [
    [ "esp:4", "strip:DIN", "green", [ "h0" ] ],
    [ "esp:5V", "strip:VCC", "red", [ "h0" ] ],
    [ "esp:GND.1", "strip:GND", "black", [ "h0" ] ]
  ],
  "serialMonitor": {
    "display": "always"
  }
}